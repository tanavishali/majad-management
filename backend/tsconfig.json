{
  "compilerOptions": {
    "target": "ES2022", "module": "ESNext", "moduleResolution": "Bundler",
    "strict": true, "skipLibCheck": true, "noEmit": true, "esModuleInterop": true,
    "resolveJsonModule": true, "types": ["node"], "noUncheckedIndexedAccess": false
  },
  "include": ["src", "tests", "vitest.config.ts", "tsup.config.ts"]
}
