NODE_ENV=development
PORT=4000
MONGO_URI=mongodb://localhost:27017/orderdesk?replicaSet=rs0
JWT_SECRET=change-me-to-a-long-random-string-of-32+chars
WEB_ORIGIN=http://localhost:5173
# First admin is created on startup if no user exists (and by `npm run seed`)
ADMIN_USERNAME=admin
ADMIN_PASSWORD=admin123
LOG_LEVEL=info
STORAGE_DRIVER=local
UPLOAD_DIR=./uploads
# 5 wrong passwords lock the account for this long
LOCKOUT_SECONDS=30
REFRESH_TOKEN_DAYS=7
COOKIE_SAMESITE=lax
TRUST_PROXY=0
# Set AUTO_INDEX=false in production and run `npm run indexes` on deploy
AUTO_INDEX=true
